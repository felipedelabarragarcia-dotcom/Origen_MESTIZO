generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String?  // hashed if used
  role      String   @default("customer") // "admin" | "customer"
  createdAt DateTime @default(now())
  orders    Order[]
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  priceCents  Int
  images      String[] @default([])
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Order {
  id         Int         @id @default(autoincrement())
  user       User?       @relation(fields: [userId], references: [id])
  userId     Int?
  totalCents Int
  status     String      @default("pending")
  items      OrderItem[]
  createdAt  DateTime    @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int
  productId Int
  title     String
  priceCents Int
  quantity  Int
}